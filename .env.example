# ── Database ──────────────────────────────────────────────────────────────────
# Prisma Postgres connection string.
# Get one at https://console.prisma.io or run `npx prisma dev` locally.
DATABASE_URL=

# ── Session ───────────────────────────────────────────────────────────────────
# Secret used by iron-session to sign and encrypt session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Market Data ───────────────────────────────────────────────────────────────
# Alpha Vantage API key for real-time market data ingestion.
# Free tier available at: https://www.alphavantage.co/support/#api-key
# Leave blank to run in fallback-only mode (quotes served from stored snapshots).
#
# IMPORTANT: Never use NEXT_PUBLIC_MARKET_DATA_API_KEY.
#            This key must stay server-side only.
MARKET_DATA_API_KEY=
